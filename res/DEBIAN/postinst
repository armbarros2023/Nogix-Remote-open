#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/nogixremote/nogixremote /usr/bin/nogixremote

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/nogixremote.service ]; then
			rm -f /etc/systemd/system/nogixremote.service /usr/lib/systemd/system/nogixremote.service /usr/lib/systemd/user/nogixremote.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/nogixremote/files/systemd/nogixremote.service /usr/lib/systemd/system/nogixremote.service
		# try fix error in Ubuntu 18.04
		# Failed to reload nogixremote.service: Unit nogixremote.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/nogixremote.service:10: Executable path is not absolute: pkill -f "nogixremote --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/nogixremote.service
		fi
		systemctl daemon-reload
		systemctl enable nogixremote
		systemctl start nogixremote
	fi
fi
